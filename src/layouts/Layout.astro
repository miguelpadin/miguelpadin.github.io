---
import { execSync } from 'node:child_process';
import '../styles/global.css';
import { useTranslations, type Lang, languages } from '../i18n';
import CookieBanner from '../components/CookieBanner.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
}

const {
  title = 'Miguel Padín Domínguez — Software Engineer',
  lang = 'en',
} = Astro.props;

const description = Astro.props.description ?? useTranslations(lang).hero.description;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteUrl = String(Astro.site).replace(/\/$/, '');
const commitHash = execSync('git rev-parse --short HEAD').toString().trim();
const commitDate = execSync('git log -1 --format=%cd').toString().trim();
const commitMsg = execSync('git log -1 --format=%s').toString().trim();

const jobTitles: Record<string, string> = {
  en: 'Software Engineer',
  es: 'Ingeniero de Software',
  gl: 'Enxeñeiro de Software',
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Miguel Padín Domínguez',
  jobTitle: jobTitles[lang] ?? jobTitles.en,
  url: siteUrl + '/',
  email: 'miguel.padin.dominguez@gmail.com',
  image: siteUrl + '/og-image.svg',
  sameAs: [
    'https://linkedin.com/in/miguelpadin',
    'https://github.com/miguelpadin',
  ],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Las Palmas de Gran Canaria',
    addressCountry: 'ES',
  },
  knowsAbout: ['Vue.js', 'Nuxt', 'TypeScript', 'Python', 'Odoo', 'PostgreSQL', 'Node.js', 'DDD', 'Clean Architecture', 'TDD'],
};

// -- Dynamic hreflang --
const rawPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const locales = Object.keys(languages) as Lang[];

function hreflangUrl(targetLang: Lang): string {
  let resultPath: string;
  if (lang === 'en') {
    const base = rawPath === '/' ? '' : rawPath;
    resultPath = targetLang === 'en' ? base + '/' : '/' + targetLang + base + '/';
  } else {
    const prefix = '/' + lang;
    const base = rawPath.startsWith(prefix) ? rawPath.slice(prefix.length) : rawPath;
    resultPath = targetLang === 'en' ? (base || '/') : '/' + targetLang + (base || '') + '/';
  }
  if (resultPath !== '/') resultPath = resultPath.replace(/\/?$/, '/');
  return siteUrl + resultPath;
}
---

<!doctype html>
<html lang={lang}>
  <head>
    <Fragment set:html={`<!-- Developed by Miguel Padín Domínguez — https://miguelpadin.github.io/ -->`} />
    <Fragment set:html={`<!-- Build: ${commitDate} | ${commitMsg} | ${commitHash} -->`} />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Miguel Padín Domínguez" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Miguel Padín Domínguez" />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : lang === 'es' ? 'es_ES' : 'gl_ES'} />
    <meta property="og:image" content={`${siteUrl}/og-image.svg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/og-image.svg`} />

    <!-- hreflang -->
    {locales.map(l => (
      <link rel="alternate" hreflang={l} href={hreflangUrl(l)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={hreflangUrl('en')} />

    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href={`${import.meta.env.BASE_URL}sitemap.xml`} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Archivo:ital,wdth,wght@0,62..125,100..900;1,62..125,100..900&family=IBM+Plex+Mono:wght@400;500&display=swap" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:ital,wdth,wght@0,62..125,100..900;1,62..125,100..900&family=IBM+Plex+Mono:wght@400;500&display=swap" /></noscript>
    <meta name="theme-color" id="theme-color" content="#F6F3EE" />
    <title>{title}</title>
    <ClientRouter />

    <!-- Google tag (gtag.js) — consent denied by default until user accepts -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', { analytics_storage: 'denied' });
    </script>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-2R8M9VFJM9"></script>
    <script is:inline>
      gtag('js', new Date());
      gtag('config', 'G-2R8M9VFJM9');
    </script>

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="min-h-screen fade-in">
    <div class="scroll-progress" aria-hidden="true"></div>
    <slot />

    <CookieBanner lang={lang} />

    <script>
      // ── View Transitions: astro:page-load fires on first load AND on
      // every client-side navigation. Each feature dedupes via dataset
      // guards or fresh listeners on the freshly swapped DOM.
      document.addEventListener('astro:page-load', () => {
        let ticking = false;

        // ── Scroll-driven skill reveals (R31): when the browser supports
        // animation-timeline, CSS owns the reveal and the IO baseline
        // must NOT also bind (it would fight the view() animation).
        if (CSS.supports('animation-timeline: view()')) {
          document.querySelectorAll('.skill-group[data-reveal]').forEach((el) => {
            el.removeAttribute('data-reveal');
          });
        }

        // ── Scroll progress (rAF-throttled, no layout thrash) ──────────
        const progressEl = document.querySelector('.scroll-progress');
        const updateProgress = () => {
          const doc = document.documentElement;
          const max = doc.scrollHeight - window.innerHeight;
          const p = max > 0 ? Math.min(window.scrollY / max, 1) : 0;
          progressEl?.style.setProperty('--scroll-progress', String(p));
          ticking = false;
        };
        window.addEventListener('scroll', () => {
          if (!ticking) { requestAnimationFrame(updateProgress); ticking = true; }
        }, { passive: true });
        updateProgress();

        // ── Scroll reveal ──────────────────────────────────────────────
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
        );
        document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));

        // ── Active nav on scroll ───────────────────────────────────────
        const sectionIds = ['experience', 'skills', 'contact'];
        const navLinks = Object.fromEntries(
          sectionIds.map(id => [id, document.querySelector<HTMLElement>(`a[href="#${id}"]`)])
        );

        const sectionObserver = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            const link = navLinks[entry.target.id];
            if (!link) return;
            link.style.color = entry.isIntersecting ? 'var(--color-accent-text)' : 'var(--color-hue2)';
          });
        }, { threshold: 0.25 });

        sectionIds.forEach(id => {
          const el = document.getElementById(id);
          if (el) sectionObserver.observe(el);
        });

        // ── Hero spotlight + name parallax (rAF-throttled) ─────────────
        const hero = document.getElementById('hero-section');
        const parallaxEls = hero ? hero.querySelectorAll('[data-parallax]') : [];
        const finePointer = window.matchMedia('(pointer: fine)');
        const noMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        if (hero && finePointer.matches && !noMotion.matches) {
          hero.addEventListener('pointermove', (e) => {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(() => {
              const r = hero.getBoundingClientRect();
              hero.style.setProperty('--mx', `${e.clientX - r.left}px`);
              hero.style.setProperty('--my', `${e.clientY - r.top}px`);
              ticking = false;
            });
          }, { passive: true });
        }
        if (!noMotion.matches && parallaxEls.length) {
          const updateParallax = () => {
            const y = window.scrollY;
            parallaxEls.forEach((el) => {
              const speed = parseFloat(el.dataset.parallax || '0.12');
              el.style.transform = `translateY(${y * speed * -1}px)`;
            });
            ticking = false;
          };
          window.addEventListener('scroll', () => {
            if (!ticking) { requestAnimationFrame(updateParallax); ticking = true; }
          }, { passive: true });
          updateParallax();
        }
      });
    </script>
  </body>
</html>
