---
import type { Translations } from '../i18n';

interface Props {
  t: Translations;
}
const { t } = Astro.props;
---

<section id="experience" class="px-8 py-32" aria-labelledby="experience-heading">
  <div class="max-w-5xl mx-auto">

    <h2
      id="experience-heading"
      class="mb-20"
      style="
        font-family: var(--font-display);
        font-weight: var(--font-display-weight);
        font-size: clamp(1.75rem, 3.5vw, 2.5rem);
        color: var(--color-fg);
        letter-spacing: var(--font-display-tracking);
      "
      data-reveal
    >
      {t.experience.label}
    </h2>

    <div class="space-y-0">
      {t.experience.jobs.map((job, i) => (
        <div
          class="job-entry py-12"
          data-reveal
          data-reveal-delay={String(i % 3)}
        >
          <div class="grid grid-cols-1 lg:grid-cols-[240px_1fr] gap-4 lg:gap-16">
            <div class="lg:sticky lg:top-24 self-start">
              <p class="mono-label mb-4" style="color: var(--color-hue2);">
                {job.period}
              </p>
              <p class="text-sm mb-1" style="color: var(--color-secondary);">
                {job.location}
              </p>
              {job.current && (
                <p class="mono-label flex items-center gap-2" style="color: var(--color-accent-text);">
                  <span class="current-dot" aria-hidden="true"></span>{t.experience.current}
                </p>
              )}
            </div>

            <div>
              <h3
                class="mb-2"
                style="
                  font-family: var(--font-display);
                  font-weight: var(--font-display-weight);
                  font-size: clamp(1.5rem, 2.5vw, 2rem);
                  color: var(--color-fg);
                  letter-spacing: var(--font-display-tracking);
                "
              >
                {job.url ? (
                  <a
                    href={job.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    style="color: inherit; text-decoration: none;"
                    class="company-link link-underline"
                  >
                    {job.company}
                  </a>
                ) : job.company}
              </h3>
              <p class="text-sm mb-6" style="color: var(--color-secondary);">
                {job.role}
              </p>
              <ul class="space-y-4">
                {job.highlights.map((item) => (
                  <li>
                    <p class="text-sm leading-relaxed" style="color: var(--color-secondary);">
                      {item}
                    </p>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>