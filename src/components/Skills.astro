---

<section id="skills" class="px-8 py-32" style="background: var(--color-surface);" aria-labelledby="skills-heading">
  <div class="max-w-5xl mx-auto">

    <h2
      id="skills-heading"
      class="skills-heading"
      style="
        font-family: var(--font-display);
        font-weight: var(--font-display-weight);
        font-size: clamp(2.25rem, 5vw, 3.75rem);
        line-height: 1.05;
        color: var(--color-fg);
        letter-spacing: var(--font-display-tracking);
      "
      data-reveal
    >
      {t.skills.label}
    </h2>

    <div class="skills-grid">
      {t.skills.groups.map((group, i) => (
        <div
          data-reveal
          data-reveal-delay={String(i % 3)}
          class="skill-group"
        >
          <h3 class="skill-group-heading" id={`skill-group-${i}`}>
            {group.label}
          </h3>
          <ul class="skill-list" aria-labelledby={`skill-group-${i}`}>
            {group.items.map((item) => {
              const url = skillUrls[item];
              const icon = icons[item];
              const Tag = url ? 'a' : 'span';
              const extraProps = url ? { href: url, target: '_blank', rel: 'noopener noreferrer' } : {};
              return (
                <li>
                  <Tag {...extraProps} class="skill-link">
                    {icon?.type === 'si' && (
                      <img
                        src={`https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/${icon.slug}.svg`}
                        alt=""
                        width="18"
                        height="18"
                        class="skill-logo"
                        loading="lazy"
                        onerror="this.style.display='none'"
                      />
                    )}
                    {icon?.type === 'devicon' && (
                      <img
                        src={`${DI}/${icon.name}/${icon.name}-${icon.variant ?? 'original'}.svg`}
                        alt=""
                        width="18"
                        height="18"
                        class="skill-logo"
                        loading="lazy"
                        onerror="this.style.display='none'"
                      />
                    )}
                    {icon?.type === 'svg' && (
                      <svg
                        viewBox="0 0 24 24"
                        width="18"
                        height="18"
                        fill={icon.stroke ? 'none' : 'currentColor'}
                        stroke={icon.stroke ? 'currentColor' : undefined}
                        stroke-width={icon.stroke ? '2' : undefined}
                        stroke-linecap={icon.stroke ? 'round' : undefined}
                        stroke-linejoin={icon.stroke ? 'round' : undefined}
                        class="skill-logo"
                        aria-hidden="true"
                      >
                        <path d={icon.d} />
                      </svg>
                    )}
                    <span>{item}</span>
                  </Tag>
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </div>

    <dl
      class="skills-languages"
      aria-label={t.skills.languagesLabel}
      data-reveal
    >
      <div>
        <dt>
          {t.skills.spanish.label}
        </dt>
        <dd>{t.skills.spanish.level}</dd>
      </div>
      <div>
        <dt>
          {t.skills.galician.label}
        </dt>
        <dd>{t.skills.galician.level}</dd>
      </div>
      <div>
        <dt>
          {t.skills.english.label}
        </dt>
        <dd>{t.skills.english.level}</dd>
      </div>
    </dl>

  </div>
</section>

<style>
  .skills-heading {
    margin-bottom: 3rem;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem 4rem;
  }

  .skill-group {
    min-width: 0;
    padding-top: 1.5rem;
  }

  .skill-group-heading {
    margin-bottom: 0.75rem;
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: var(--font-display-tracking);
  }

  .skill-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
  }

  .skill-list li {
    max-width: 100%;
  }

  .skill-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 44px;
    min-height: 44px;
    max-width: 100%;
    padding: 0.375rem 0;
    color: var(--color-secondary);
    font-size: 1rem;
    line-height: 1.5;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  a.skill-link:hover,
  a.skill-link:focus-visible {
    color: var(--color-accent-text);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  a.skill-link:focus-visible {
    outline-offset: 4px;
  }

  .skill-logo {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    filter: brightness(0);
    opacity: 0.6;
  }

  .skills-languages {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 3rem;
    margin: 3rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .skills-languages > div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.625rem;
  }

  .skills-languages dt {
    font-weight: 600;
  }

  .skills-languages dd {
    margin: 0;
    color: var(--color-secondary);
  }

  @media (min-width: 768px) {
    .skills-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .skill-link {
      transition: color 0.15s;
    }
  }
</style>
