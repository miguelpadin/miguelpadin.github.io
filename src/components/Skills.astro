---
import type { Translations } from '../i18n';
import { skillUrls } from '../i18n';

interface Props {
  t: Translations;
}
const { t } = Astro.props;

type IconDef =
  | { type: 'si'; slug: string }
  | { type: 'devicon'; name: string; variant?: string }
  | { type: 'fallback' }
  | { type: 'svg'; d: string; viewBox?: string; stroke?: boolean };

const DI = 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons';

/* Bento spans per group index: 4+2 / 3+3 / 2+4 = 18 = three 6-col rows */
const spans = ['lg:col-span-4', 'lg:col-span-2', 'lg:col-span-3', 'lg:col-span-3', 'lg:col-span-2', 'lg:col-span-4'];
const cellVariants = ['', '', '', '', '', ''];

const icons: Record<string, IconDef> = {
  // Frontend
  'Vue':                  { type: 'si', slug: 'vuedotjs' },
  'Nuxt':                 { type: 'si', slug: 'nuxt' },
  'TypeScript':           { type: 'si', slug: 'typescript' },
  'JavaScript':           { type: 'si', slug: 'javascript' },
  'Pinia':                { type: 'si', slug: 'pinia' },
  'Vuex':                 { type: 'fallback' },
  'PrimeVue':             { type: 'si', slug: 'primevue' },
  'Quasar':               { type: 'si', slug: 'quasar' },
  'BootstrapVue':         { type: 'fallback' },
  'Tailwind':             { type: 'si', slug: 'tailwindcss' },
  'Bootstrap':            { type: 'si', slug: 'bootstrap' },
  'Bulma':                { type: 'si', slug: 'bulma' },
  'SASS':                 { type: 'si', slug: 'sass' },
  'SCSS':                 { type: 'si', slug: 'sass' },
  'Vite':                 { type: 'si', slug: 'vite' },
  'Accessibility':        { type: 'fallback' },
  'PWA':                  { type: 'si', slug: 'pwa' },
  'Flexbox':              { type: 'si', slug: 'css' },
  'CSS Grid':             { type: 'si', slug: 'css' },
  // Backend
  'Python':               { type: 'si', slug: 'python' },
  'REST APIs':            { type: 'fallback' },
  'RESTful':              { type: 'fallback' },
  'HATEOAS':              { type: 'fallback' },
  'OpenAPI':              { type: 'si', slug: 'openapiinitiative' },
  'Odoo':                 { type: 'si', slug: 'odoo' },
  'SQL':                  { type: 'si', slug: 'sqlite' },
  'PostgreSQL':           { type: 'si', slug: 'postgresql' },
  'Supabase':             { type: 'si', slug: 'supabase' },
  'Oracle':               { type: 'devicon', name: 'oracle' },
  'PL/SQL':               { type: 'devicon', name: 'oracle' },
  'Node.js':              { type: 'si', slug: 'nodedotjs' },
  'Java':                 { type: 'devicon', name: 'java' },
  // Testing
  'Vitest':               { type: 'si', slug: 'vitest' },
  'Jest':                 { type: 'si', slug: 'jest' },
  'Playwright':           { type: 'devicon', name: 'playwright' },
  'Cypress':              { type: 'si', slug: 'cypress' },
  'Vue Test Utils':       { type: 'si', slug: 'vuedotjs' },
  'Testing Library':      { type: 'si', slug: 'testinglibrary' },
  'pytest':               { type: 'si', slug: 'pytest' },
  'TDD':                  { type: 'fallback' },
  'BDD':                  { type: 'si', slug: 'cucumber' },
  // Tooling & Process
  'GitHub Actions':       { type: 'si', slug: 'githubactions' },
  'GitHub Pages':         { type: 'si', slug: 'githubpages' },
  'Vercel':               { type: 'si', slug: 'vercel' },
  'Git':                  { type: 'si', slug: 'git' },
  'CI/CD':                { type: 'fallback' },
  'Code Review':          { type: 'fallback' },
  'ESLint':               { type: 'si', slug: 'eslint' },
  'Prettier':             { type: 'si', slug: 'prettier' },
  'Husky':                { type: 'fallback' },
  'Sentry':               { type: 'si', slug: 'sentry' },
  'SonarQube':            { type: 'si', slug: 'sonarqubecloud' },
  'Linux':                { type: 'si', slug: 'linux' },
  'Windows':              { type: 'devicon', name: 'windows11' },
  'macOS':                { type: 'si', slug: 'macos' },
  'Bash':                 { type: 'si', slug: 'gnubash' },
  'Scrum':                { type: 'fallback' },
  'npm':                  { type: 'si', slug: 'npm' },
  'pnpm':                 { type: 'si', slug: 'pnpm' },
  // AI
  'Antigravity':          { type: 'fallback' },
  'Claude Code':          { type: 'si', slug: 'claude' },
  'Codex':                { type: 'fallback' },
  'Cursor':               { type: 'si', slug: 'cursor' },
  'DeepSeek':             { type: 'si', slug: 'deepseek' },
  'OpenCode':             { type: 'si', slug: 'opencode' },
  'CodeRabbit':           { type: 'si', slug: 'coderabbit' },
  'Ollama':               { type: 'si', slug: 'ollama' },
  'LM Studio':            { type: 'si', slug: 'lmstudio' },
  'Continue':             { type: 'fallback' },
  // Architecture (concepts - no official brand logos exist)
  'Hexagonal Architecture':  { type: 'svg', stroke: true, d: 'M12 2l8.66 5v10L12 22l-8.66-5V7L12 2z' },
  'Arquitectura Hexagonal':  { type: 'svg', stroke: true, d: 'M12 2l8.66 5v10L12 22l-8.66-5V7L12 2z' },
  'DDD':                  { type: 'svg', stroke: true, d: 'M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z' },
  'Clean Architecture':   { type: 'svg', stroke: true, d: 'M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10zM12 18a6 6 0 1 0 0-12 6 6 0 0 0 0 12zM12 14a2 2 0 1 0 0-4 2 2 0 0 0 0 4z' },
  'SOLID':                { type: 'svg', stroke: true, d: 'M4 4h4v4H4zM10 4h4v4h-4zM16 4h4v4h-4zM4 10h4v4H4zM10 10h4v4h-4zM16 10h4v4h-4z' },
  'REST':                 { type: 'svg', stroke: true, d: 'M4 6h16M4 10h16M4 14h16M4 18h16' },
  'MVC':                  { type: 'svg', stroke: true, d: 'M5 12a7 7 0 1 0 14 0A7 7 0 0 0 5 12zM12 5v2M12 17v2M5.6 8.6l1.4 1.4M16.9 15l1.5 1.5M3 12h2M19 12h2' },
};
---

<section id="skills" class="px-8 py-32" style="background: var(--color-surface);" aria-labelledby="skills-heading">
  <div class="max-w-5xl mx-auto">

    <h2
      id="skills-heading"
      class="mb-12"
      style="
        font-family: var(--font-display);
        font-weight: var(--font-display-weight);
        font-size: clamp(2.25rem, 5vw, 3.75rem);
        line-height: 1.05;
        color: var(--color-fg);
        letter-spacing: var(--font-display-tracking);
      "
      data-reveal
    >
      {t.skills.label}
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-6" style="margin-top: 5rem;">
      {t.skills.groups.map((group, i) => (
        <div
          data-reveal
          data-reveal-delay={String(i % 3)}
          class:list={[spans[i], cellVariants[i] ? `skill-group ${cellVariants[i]}` : 'skill-group']}
        >
          <p class="mono-label mb-4" style="color: var(--color-hue2);">
            {group.label}
          </p>
          <div class="flex flex-wrap gap-2">
            {group.items.map((item) => {
              const url = skillUrls[item];
              const icon = icons[item];
              const Tag = url ? 'a' : 'span';
              const extraProps = url ? { href: url, target: '_blank', rel: 'noopener noreferrer' } : {};
              return (
                <Tag {...extraProps} class="icon-pill" data-name={item}>
                  {icon?.type === 'si' && (
                    <img
                      src={`https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/${icon.slug}.svg`}
                      alt={item}
                      width="18"
                      height="18"
                      class="skill-logo"
                      loading="lazy"
                      onerror="this.style.display='none'"
                    />
                  )}
                  {icon?.type === 'devicon' && (
                    <img
                      src={`${DI}/${icon.name}/${icon.name}-${icon.variant ?? 'original'}.svg`}
                      alt={item}
                      width="18"
                      height="18"
                      class="skill-logo"
                      loading="lazy"
                      onerror="this.style.display='none'"
                    />
                  )}
                  {icon?.type === 'svg' && (
                    <svg
                      viewBox="0 0 24 24"
                      width="18"
                      height="18"
                      fill={icon.stroke ? 'none' : 'currentColor'}
                      stroke={icon.stroke ? 'currentColor' : undefined}
                      stroke-width={icon.stroke ? '2' : undefined}
                      stroke-linecap={icon.stroke ? 'round' : undefined}
                      stroke-linejoin={icon.stroke ? 'round' : undefined}
                      class="skill-logo"
                    >
                      <path d={icon.d} />
                    </svg>
                  )}
                  {(!icon || icon.type === 'fallback') && (
                    <span class="icon-fallback">{item.slice(0, 2).toUpperCase()}</span>
                  )}
                </Tag>
              );
            })}
          </div>
        </div>
      ))}
    </div>

    <div
      class="mt-20 pt-12 grid grid-cols-1 sm:grid-cols-3 gap-8"
      style="border-top: 1px solid var(--color-border);"
      data-reveal
    >
      <div>
        <p class="mono-label mb-2" style="color: var(--color-hue2);">
          {t.skills.spanish.label}
        </p>
        <p class="text-sm" style="color: var(--color-secondary);">{t.skills.spanish.level}</p>
      </div>
      <div>
        <p class="mono-label mb-2" style="color: var(--color-hue2);">
          {t.skills.galician.label}
        </p>
        <p class="text-sm" style="color: var(--color-secondary);">{t.skills.galician.level}</p>
      </div>
      <div>
        <p class="mono-label mb-2" style="color: var(--color-hue2);">
          {t.skills.english.label}
        </p>
        <p class="text-sm" style="color: var(--color-secondary);">{t.skills.english.level}</p>
      </div>
    </div>

  </div>
</section>

<style>
  .icon-pill {
    position: relative;
    overflow: visible;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-bg);
    transition: border-color 0.2s, background 0.2s;
    cursor: default;
    text-decoration: none;
  }
  a.icon-pill { cursor: pointer; }

  .icon-pill:hover {
    border-color: var(--color-accent);
    background: rgba(232, 84, 47, 0.05);
  }

  /* Tooltip */
  .icon-pill::after {
    content: attr(data-name);
    position: absolute;
    bottom: calc(100% + 7px);
    left: 50%;
    transform: translateX(-50%) translateY(4px);
    background: var(--color-fg);
    color: var(--color-bg);
    font-size: 10px;
    font-family: var(--font-display);
    font-weight: var(--font-display-weight);
    letter-spacing: var(--font-display-tracking);
    text-transform: uppercase;
    padding: 4px 8px;
    border-radius: 4px;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s, transform 0.15s;
    z-index: 100;
  }
  .icon-pill:hover::after {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  /* Monochrome icons (site is always light) */
  .skill-logo {
    filter: brightness(0);
    opacity: 0.6;
  }
  .icon-pill:hover .skill-logo {
    opacity: 0.9;
  }

  /* Fallback text for skills without icon */
  .icon-fallback {
    font-size: 9px;
    font-family: var(--font-display);
    font-weight: var(--font-display-weight);
    color: var(--color-muted);
    letter-spacing: var(--font-display-tracking);
  }
</style>