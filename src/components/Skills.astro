---
import type { Translations } from '../i18n';
import { skillUrls } from '../i18n';

interface Props {
  t: Translations;
}
const { t } = Astro.props;

function renderItems(items: readonly string[]) {
  return items.map((item, i) => {
    const url = skillUrls[item];
    const isLast = i === items.length - 1;
    return url
      ? {
          link: true,
          href: url,
          item,
          sep: isLast ? '' : ', ',
        }
      : {
          link: false,
          item,
          sep: isLast ? '' : ', ',
        };
  });
}
---

<section id="skills" class="px-8 py-32" style="background: var(--color-surface);" aria-labelledby="skills-heading">
  <div class="max-w-5xl mx-auto">

    <h2
      id="skills-heading"
      class="mb-12"
      style="
        font-family: var(--font-display);
        font-weight: var(--font-display-weight);
        font-size: clamp(1.75rem, 3.5vw, 2.5rem);
        color: var(--color-fg);
        letter-spacing: var(--font-display-tracking);
      "
      data-reveal
    >
      {t.skills.label}
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-16 gap-y-12" style="margin-top: 5rem;">
      {t.skills.groups.map((group, i) => (
        <div
          data-reveal
          data-reveal-delay={String(i % 3)}
          class="skill-group"
        >
          <p class="mono-label mb-4" style="color: var(--color-hue2);">
            {group.label}
          </p>
          <p class="text-sm leading-loose" style="color: var(--color-secondary);">
            {renderItems(group.items).map(({ link, href, item, sep }) =>
              link ? (
                <>
                  <a
                    href={href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="skill-link transition-colors duration-200"
                    style="color: var(--color-secondary);"
                  >
                    {item}
                  </a>{sep}
                </>
              ) : (
                <span>{item}{sep}</span>
              )
            )}
          </p>
        </div>
      ))}
    </div>

    <div
      class="mt-20 pt-12 grid grid-cols-1 sm:grid-cols-3 gap-8"
      style="border-top: 1px solid var(--color-border);"
      data-reveal
    >
      <div>
        <p class="mono-label mb-2" style="color: var(--color-hue2);">
          {t.skills.spanish.label}
        </p>
        <p class="text-sm" style="color: var(--color-secondary);">{t.skills.spanish.level}</p>
      </div>
      <div>
        <p class="mono-label mb-2" style="color: var(--color-hue2);">
          {t.skills.galician.label}
        </p>
        <p class="text-sm" style="color: var(--color-secondary);">{t.skills.galician.level}</p>
      </div>
      <div>
        <p class="mono-label mb-2" style="color: var(--color-hue2);">
          {t.skills.english.label}
        </p>
        <p class="text-sm" style="color: var(--color-secondary);">{t.skills.english.level}</p>
      </div>
    </div>

  </div>
</section>