---
import type { Translations } from '../i18n';
import { skillUrls } from '../i18n';

interface Props {
  t: Translations;
}
const { t } = Astro.props;

// Flattened skill names for the marquee strip (order follows the groups).
const allSkills = t.skills.groups.flatMap((group) => group.items);

function renderItems(items: readonly string[]) {
  return items.map((item, i) => {
    const url = skillUrls[item];
    const isLast = i === items.length - 1;
    return url
      ? {
          link: true,
          href: url,
          item,
          sep: isLast ? '' : ', ',
        }
      : {
          link: false,
          item,
          sep: isLast ? '' : ', ',
        };
  });
}
---

<section id="skills" class="px-8 py-32" style="background: var(--color-surface);" aria-labelledby="skills-heading">
  <div class="max-w-5xl mx-auto">

    <h2
      id="skills-heading"
      class="mb-12"
      style="
        font-family: var(--font-display);
        font-weight: var(--font-display-weight);
        font-size: clamp(1.75rem, 3.5vw, 2.5rem);
        color: var(--color-fg);
        letter-spacing: var(--font-display-tracking);
      "
      data-reveal
    >
      {t.skills.label}
    </h2>

    <!-- Full-width marquee strip: every skill in one slow line. Single marquee on the page. -->
    <div
      class="marquee-strip mt-20 mb-20"
      style="border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); overflow: clip; max-width: 100vw;"
    >
      <div class="marquee-track" style="display: flex; width: max-content; max-width: none;">
        {[0, 1].map((copy) => (
          <div
            class="marquee-segment"
            style="display: flex; align-items: center; white-space: nowrap; padding: 0.875rem 0; font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.06em; color: var(--color-secondary);"
            aria-hidden={copy === 1 ? 'true' : undefined}
          >
            {allSkills.map((skill, i) => (
              <span style="display: inline-flex; align-items: center;">
                <span style="padding: 0 1.125rem;">{skill}</span>
                {i < allSkills.length - 1 && <span style="color: var(--color-muted);" aria-hidden="true">·</span>}
              </span>
            ))}
          </div>
        ))}
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-16 gap-y-12">
      {t.skills.groups.map((group, i) => (
        <div
          data-reveal
          data-reveal-delay={String(i % 3)}
          style="border-top: 1px solid var(--color-border); padding-top: 1.25rem;"
        >
          <p class="mono-label mb-4" style="color: var(--color-muted);">
            {group.label}
          </p>
          <p class="text-sm leading-loose" style="color: var(--color-secondary);">
            {renderItems(group.items).map(({ link, href, item, sep }) =>
              link ? (
                <>
                  <a
                    href={href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="skill-link transition-colors duration-200"
                    style="color: var(--color-secondary);"
                  >
                    {item}
                  </a>{sep}
                </>
              ) : (
                <span>{item}{sep}</span>
              )
            )}
          </p>
        </div>
      ))}
    </div>

    <div
      class="mt-20 pt-12 grid grid-cols-1 sm:grid-cols-3 gap-8"
      style="border-top: 1px solid var(--color-border);"
      data-reveal
    >
      <div>
        <p class="mono-label mb-2" style="color: var(--color-muted);">
          {t.skills.spanish.label}
        </p>
        <p class="text-sm" style="color: var(--color-secondary);">{t.skills.spanish.level}</p>
      </div>
      <div>
        <p class="mono-label mb-2" style="color: var(--color-muted);">
          {t.skills.galician.label}
        </p>
        <p class="text-sm" style="color: var(--color-secondary);">{t.skills.galician.level}</p>
      </div>
      <div>
        <p class="mono-label mb-2" style="color: var(--color-muted);">
          {t.skills.english.label}
        </p>
        <p class="text-sm" style="color: var(--color-secondary);">{t.skills.english.level}</p>
      </div>
    </div>

  </div>
</section>