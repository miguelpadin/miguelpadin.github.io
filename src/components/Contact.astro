---
import type { Translations } from '../i18n';

interface Props {
  t: Translations;
}
const { t } = Astro.props;

const links = [
  {
    label: 'miguel.padin.dominguez@gmail.com',
    href: 'mailto:miguel.padin.dominguez@gmail.com',
  },
  {
    label: 'WhatsApp',
    href: 'https://wa.me/34639476354',
  },
  {
    label: 'Telegram',
    href: 'https://t.me/+34639476354',
  },
];
---

<section id="contact" class="px-8 py-32" aria-labelledby="contact-heading">
  <div class="max-w-5xl mx-auto">

    <h2
      id="contact-heading"
      class="mb-16 leading-none"
      style="
        font-family: var(--font-display);
        font-weight: var(--font-display-weight);
        font-size: clamp(1.75rem, 3.5vw, 2.5rem);
        color: var(--color-fg);
        letter-spacing: var(--font-display-tracking);
      "
      data-reveal
    >
      {t.contact.heading[0]}<br />
      <span style="color: var(--color-muted);">{t.contact.heading[1]}</span>
    </h2>

    <p class="text-base leading-loose mb-16 max-w-md" style="color: var(--color-secondary);" data-reveal>
      {t.contact.subtext}
    </p>

    <!-- Email as the dominant display element -->
    <a
      href="mailto:miguel.padin.dominguez@gmail.com"
      class="link-underline inline-block mb-8 leading-none"
      style="
        font-family: var(--font-display);
        font-weight: 700;
        font-size: clamp(1.25rem, 4vw, 2.5rem);
        color: var(--color-fg);
        letter-spacing: var(--font-display-tracking);
        word-break: break-all;
      "
      data-reveal
    >
      miguel.padin.dominguez@gmail.com
    </a>

    <div class="flex flex-col" data-reveal>
      {links.filter(({ label }) => label !== 'miguel.padin.dominguez@gmail.com').map(({ label, href }) => (
        <a
          href={href}
          target={href.startsWith('http') ? '_blank' : undefined}
          rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}
          class="contact-link contact-row flex items-center gap-4 py-5 transition-colors duration-200"
          style="border-top: 1px solid var(--color-border); color: var(--color-fg);"
        >
          <span
            class="font-medium"
            style="font-family: var(--font-display); font-weight: var(--font-display-weight); font-size: clamp(0.95rem, 2vw, 1.15rem); letter-spacing: var(--font-display-tracking);"
          >
            {label}
          </span>
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="contact-arrow"
            aria-hidden="true"
          >
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
      ))}
      <div style="border-top: 1px solid var(--color-border);"></div>
    </div>

  </div>
</section>