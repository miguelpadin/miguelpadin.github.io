---
import type { Lang } from '../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;

const cookiesUrl = lang !== 'en'
  ? `${import.meta.env.BASE_URL}${lang}/cookies/`
  : `${import.meta.env.BASE_URL}cookies/`;

const copy = {
  en: {
    label: 'Cookies',
    necessary: 'Necessary',
    necessaryBadge: 'Always active',
    necessaryDesc: 'Stores your cookie preference.',
    analytics: 'Analytics',
    analyticsBadge: 'Optional',
    analyticsDesc: 'Google Analytics and Hotjar (session recordings and heatmaps) — usage data used to improve this site.',
    cookies: 'Cookie policy',
    accept: 'Accept all',
    decline: 'Necessary only',
  },
  es: {
    label: 'Cookies',
    necessary: 'Necesarias',
    necessaryBadge: 'Siempre activas',
    necessaryDesc: 'Guarda tu preferencia de cookies.',
    analytics: 'Analíticas',
    analyticsBadge: 'Opcionales',
    analyticsDesc: 'Google Analytics y Hotjar (grabaciones de sesión y mapas de calor) — datos de uso para mejorar este sitio.',
    cookies: 'Política de cookies',
    accept: 'Aceptar todo',
    decline: 'Solo necesarias',
  },
  gl: {
    label: 'Cookies',
    necessary: 'Necesarias',
    necessaryBadge: 'Sempre activas',
    necessaryDesc: 'Garda a túa preferencia de cookies.',
    analytics: 'Analíticas',
    analyticsBadge: 'Opcionais',
    analyticsDesc: 'Google Analytics e Hotjar (gravacións de sesión e mapas de calor) — datos de uso para mellorar este sitio.',
    cookies: 'Política de cookies',
    accept: 'Aceptar todo',
    decline: 'Só necesarias',
  },
} as const;

const c = copy[lang];
---

<div
  id="cookie-banner"
  role="dialog"
  aria-label={c.label}
  aria-live="polite"
  style="
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    transform: translateY(calc(100% + 2rem));
    z-index: 99999;
    width: min(calc(100vw - 3rem), 380px);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 1.25rem 1.5rem 1.125rem;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    opacity: 0;
    pointer-events: none;
    transition: transform 0.5s cubic-bezier(0.16,1,0.3,1), opacity 0.5s cubic-bezier(0.16,1,0.3,1);
  "
>
  <!-- Label -->
  <p style="
    font-family: var(--font-display);
    font-weight: var(--font-display-weight);
    font-size: 0.625rem;
    letter-spacing: var(--font-display-tracking);
    text-transform: uppercase;
    color: var(--color-accent-text);
    margin: 0;
  ">{c.label}</p>

  <!-- Necessary row -->
  <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 0.75rem;">
    <div>
      <p style="
        font-family: var(--font-display);
        font-weight: var(--font-display-weight);
        font-size: 0.6875rem;
        letter-spacing: var(--font-display-tracking);
        text-transform: uppercase;
        color: var(--color-fg);
        margin: 0 0 0.25rem;
      ">{c.necessary}</p>
      <p style="
        font-family: var(--font-body);
        font-size: 0.75rem;
        color: var(--color-muted);
        margin: 0;
        line-height: 1.5;
      ">{c.necessaryDesc}</p>
    </div>
    <span style="
      flex-shrink: 0;
      font-family: var(--font-display);
      font-weight: var(--font-display-weight);
      font-size: 0.5625rem;
      letter-spacing: var(--font-display-tracking);
      text-transform: uppercase;
      color: rgba(74,200,120,0.85);
      background: rgba(74,200,120,0.1);
      border: 1px solid rgba(74,200,120,0.2);
      border-radius: 20px;
      padding: 0.2rem 0.55rem;
      white-space: nowrap;
      margin-top: 0.1rem;
    ">{c.necessaryBadge}</span>
  </div>

  <!-- Divider -->
  <div style="height: 1px; background: var(--color-border);"></div>

  <!-- Analytics row -->
  <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 0.75rem;">
    <div>
      <p style="
        font-family: var(--font-display);
        font-weight: var(--font-display-weight);
        font-size: 0.6875rem;
        letter-spacing: var(--font-display-tracking);
        text-transform: uppercase;
        color: var(--color-fg);
        margin: 0 0 0.25rem;
      ">{c.analytics}</p>
      <p style="
        font-family: var(--font-body);
        font-size: 0.75rem;
        color: var(--color-muted);
        margin: 0;
        line-height: 1.5;
      ">{c.analyticsDesc}</p>
    </div>
    <span style="
      flex-shrink: 0;
      font-family: var(--font-display);
      font-weight: var(--font-display-weight);
      font-size: 0.5625rem;
      letter-spacing: var(--font-display-tracking);
      text-transform: uppercase;
      color: var(--color-muted);
      background: transparent;
      border: 1px solid var(--color-border);
      border-radius: 20px;
      padding: 0.2rem 0.55rem;
      white-space: nowrap;
      margin-top: 0.1rem;
    ">{c.analyticsBadge}</span>
  </div>

  <!-- Actions -->
  <div style="display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; flex-wrap: wrap; margin-top: 0.125rem;">
    <a
      href={cookiesUrl}
      class="cb-link"
      style="
        font-family: var(--font-display);
        font-weight: var(--font-display-weight);
        font-size: 0.5625rem;
        letter-spacing: var(--font-display-tracking);
        text-transform: uppercase;
        color: var(--color-muted);
        text-decoration: underline;
        text-underline-offset: 3px;
        transition: color 0.2s;
      "
    >{c.cookies}</a>
    <div style="display: flex; gap: 0.5rem;">
      <button
        id="cookie-decline"
        style="
          font-family: var(--font-display);
          font-weight: var(--font-display-weight);
          font-size: 0.5625rem;
          letter-spacing: var(--font-display-tracking);
          text-transform: uppercase;
          color: var(--color-muted);
          background: transparent;
          border: 1px solid var(--color-border);
          border-radius: 4px;
          padding: 0.45rem 0.875rem;
          cursor: pointer;
          transition: color 0.2s, border-color 0.2s;
        "
      class="cb-decline">{c.decline}</button>
      <button
        id="cookie-accept"
        style="
          font-family: var(--font-display);
          font-weight: var(--font-display-weight);
          font-size: 0.5625rem;
          letter-spacing: var(--font-display-tracking);
          text-transform: uppercase;
          color: #111115;
          background: var(--color-accent);
          border: 1px solid transparent;
          border-radius: 4px;
          padding: 0.45rem 0.875rem;
          cursor: pointer;
          transition: opacity 0.2s;
        "
      class="cb-accept">{c.accept}</button>
    </div>
  </div>
</div>

<style>
  .cb-link:hover { color: var(--color-accent-text) !important; }
  .cb-decline:hover { color: var(--color-fg) !important; border-color: var(--color-muted) !important; }
  .cb-accept:hover { opacity: 0.82 !important; }
</style>

<script>
  import {
    recordConsent,
    readEffectiveConsent,
  } from '../scripts/hotjar-consent.mjs';

  // Tracks the pending show-banner timer so a swap can cancel it before
  // it fires against a detached element. Module-level so the value
  // outlives a single `initBanner` call.
  let pendingShow = 0;

  function findBannerElements() {
    const banner = document.getElementById('cookie-banner');
    const accept = document.getElementById('cookie-accept');
    const decline = document.getElementById('cookie-decline');
    if (!banner || !accept || !decline) return null;
    return { banner, accept, decline };
  }

  function hideBanner(banner) {
    if (pendingShow) { clearTimeout(pendingShow); pendingShow = 0; }
    banner.style.transform = 'translateY(calc(100% + 2rem))';
    banner.style.opacity = '0';
    banner.style.pointerEvents = 'none';
  }

  function showBannerLater(banner) {
    if (pendingShow) clearTimeout(pendingShow);
    const show = () => {
      banner.style.transform = 'translateY(0)';
      banner.style.opacity = '1';
      banner.style.pointerEvents = 'auto';
    };
    pendingShow = setTimeout(show, 900);
  }

  function bindClickHandlers({ banner, accept, decline }) {
    // Using `onclick =` is intentional: the element is brand new on
    // every page load, so there is no prior handler to leak.
    accept.onclick = () => {
      recordConsent('granted');
      hideBanner(banner);
    };
    decline.onclick = () => {
      const persisted = recordConsent('denied');
      hideBanner(banner);
      // Safe full-reload boundary: only reload when the denial was
      // persisted. If storage is blocked, do NOT reload — the next full
      // page load will read no consent and stay denied, preventing a
      // reload loop. Hotjar has no public opt-out API on `window.hj`,
      // so a controlled reload is the only safe way to stop the snippet
      // once it has started running on this page.
      if (persisted) {
        try { location.reload(); } catch { /* sandboxed env */ }
      }
    };
  }

  // Per-load init + per-navigation re-bind. The Astro ClientRouter
  // replaces the document on every client-side nav, so the previously
  // bound click handlers and pending show timer are gone. This runs
  // once on the initial load (Astro fires `astro:page-load` for the
  // first paint) and again on every subsequent client-side navigation.
  function initBanner() {
    const elements = findBannerElements();
    if (!elements) return;
    // Fresh read on every page load — never trust a cached value
    // because another tab may have changed the versioned payload, and
    // the effective reader (inMemory > hash > session > local) is what
    // guarantees a same-tab denial is honored over a stale local grant.
    const effective = readEffectiveConsent();
    if (effective === 'granted' || effective === 'denied') {
      hideBanner(elements.banner);
      return;
    }
    // Legacy raw string OR no consent — re-ask under the new shape.
    showBannerLater(elements.banner);
    bindClickHandlers(elements);
  }

  document.addEventListener('astro:page-load', initBanner);
</script>
