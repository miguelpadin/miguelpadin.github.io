---
interface Props {
  size?: number;
}
const { size = 32 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 40 40"
  xmlns="http://www.w3.org/2000/svg"
  fill="none"
  aria-label="Miguel Padín Domínguez"
>
  <rect width="40" height="40" rx="7" fill="#1A1917"/>
  <rect x="0.5" y="0.5" width="39" height="39" rx="6.5" stroke="#E3E0D8" stroke-width="1" fill="none" opacity="0.5"/>
  <text
    x="50%" y="50%"
    text-anchor="middle"
    dominant-baseline="central"
    font-family="Archivo, system-ui, sans-serif"
    font-weight="700"
    font-size="12"
    letter-spacing="-0.02em"
    fill="#FAF9F6"
  >MP</text>
</svg>