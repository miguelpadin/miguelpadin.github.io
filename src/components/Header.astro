---
import { languages, getLangUrl, type Lang, type Translations } from '../i18n';
import Logo from './Logo.astro';

interface Props {
  lang: Lang;
  t: Translations;
}
const { lang, t } = Astro.props;
---

<header
  id="site-header"
  class="fixed top-0 inset-x-0 z-50 px-8"
>
  <div class="max-w-5xl mx-auto flex items-center justify-between h-16">
    <a
      href={getLangUrl(lang)}
      class="flex items-center gap-3 transition-opacity duration-200 hover:opacity-80"
    >
      <Logo size={28} />
      <span
        class="text-xs font-semibold hidden sm:block"
        style="color: var(--color-secondary); font-family: var(--font-display); font-weight: var(--font-display-weight); letter-spacing: var(--font-display-tracking); white-space: nowrap;"
      >
        Miguel Padín Domínguez
      </span>
    </a>

    <div class="flex items-center gap-8">
      <!-- Nav -->
      <nav class="hidden sm:flex items-center gap-8">
        {[
          { label: t.nav.experience, href: '#experience' },
          { label: t.nav.skills, href: '#skills' },
          { label: t.nav.contact, href: '#contact' },
        ].map(({ label, href }) => (
          <a
            href={href}
            class="nav-link text-xs uppercase tracking-[0.15em] transition-colors duration-200"
            style="color: var(--color-secondary); font-family: var(--font-display); font-weight: var(--font-display-weight); letter-spacing: var(--font-display-tracking);"
          >
            {label}
          </a>
        ))}
      </nav>

      <!-- Language switcher -->
      <div class="flex items-center gap-1" style="border-left: 1px solid var(--color-border); padding-left: 1.5rem;">
        {(Object.keys(languages) as Lang[]).map((l) => (
          <a
            href={getLangUrl(l)}
            class="text-[11px] px-1.5 py-0.5 transition-colors duration-200"
            style={`
              font-family: var(--font-mono);
              color: ${l === lang ? 'var(--color-accent)' : 'var(--color-muted)'};
            `}
          >
            {languages[l]}
          </a>
        ))}
      </div>
    </div>
  </div>
</header>

<style>
  header#site-header {
    background: transparent;
    border-bottom: 1px solid transparent;
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }
  header#site-header.is-scrolled {
    background: rgba(250, 249, 246, 0.92);
    border-bottom-color: var(--color-border);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
</style>

<script>
  // Minimal scrolled state: paper background + hairline border.
  const header = document.getElementById('site-header');
  const update = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  update();
  window.addEventListener('scroll', update, { passive: true });
</script>