---
import { languages, getLangUrl, type Lang, type Translations } from '../i18n';

interface Props {
  lang: Lang;
  t: Translations;
}
const { lang, t } = Astro.props;
---

<header
  id="site-header"
  class="fixed top-0 inset-x-0 z-50 px-8"
>
  <div class="max-w-5xl mx-auto flex items-center justify-between gap-3 h-16">
    <a
      href={getLangUrl(lang)}
      class="min-w-0 transition-opacity duration-200 hover:opacity-80"
    >
      <span
        class="text-sm hidden sm:block"
        style="color: var(--color-fg); font-family: var(--font-display); font-weight: var(--font-display-weight); letter-spacing: var(--font-display-tracking); white-space: nowrap;"
      >
        Miguel Padín Domínguez
      </span>
      <span
        class="text-sm sm:hidden"
        style="color: var(--color-fg); font-family: var(--font-display); font-weight: var(--font-display-weight); letter-spacing: var(--font-display-tracking); white-space: nowrap;"
      >
        Miguel Padín
      </span>
    </a>

    <div class="flex items-center gap-4 sm:gap-8 min-w-0">
      <!-- Nav -->
      <nav class="hidden sm:flex items-center gap-8">
        {[
          { label: t.nav.experience, href: '#experience' },
          { label: t.nav.skills, href: '#skills' },
          { label: t.nav.contact, href: '#contact' },
        ].map(({ label, href }) => (
          <a
            href={href}
            class="nav-link nav-scramble text-xs uppercase tracking-[0.15em] transition-colors duration-200"
            data-text={label}
            style="color: var(--color-secondary); font-family: var(--font-display); font-weight: var(--font-display-weight); letter-spacing: var(--font-display-tracking);"
          >
            {label}
          </a>
        ))}
      </nav>

      <!-- Language switcher -->
      <div class="flex items-center gap-1 flex-shrink-0" style="border-left: 1px solid var(--color-border); padding-left: 0.75rem;">
        {(Object.keys(languages) as Lang[]).map((l) => (
          <a
            href={getLangUrl(l)}
            class="text-[11px] px-1 py-0.5 transition-colors duration-200"
            style={`
              font-family: var(--font-mono);
              color: ${l === lang ? 'var(--color-accent-text)' : 'var(--color-muted)'};
            `}
          >
            {languages[l]}
          </a>
        ))}
      </div>
    </div>
  </div>
</header>

<style>
  header#site-header {
    background: transparent;
    border-bottom: 1px solid transparent;
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }
  header#site-header.is-scrolled {
    background: rgba(246, 243, 238, 0.92);
    border-bottom-color: var(--color-border);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
</style>

<script>
  // Minimal scrolled state: paper background + hairline border.
  const header = document.getElementById('site-header');
  const update = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  update();
  window.addEventListener('scroll', update, { passive: true });
</script>

<script>
  // ── Text scramble decode on nav hover ─────────────────────────
  // Label text is only swapped during the animation; the final frame
  // restores the original string exactly (SEO/screen readers safe).
  document.querySelectorAll('.nav-scramble').forEach((link) => {
    if (link.dataset.scrambleBound) return;
    link.dataset.scrambleBound = '1';
    const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ<>/{}[]();=';
    const original = (link as HTMLElement).dataset.text || link.textContent!.trim();
    let frame = 0;
    let raf: number | null = null;
    const run = () => {
      frame++;
      const progress = frame / 3;
      const done = Math.floor(progress);
      const out = original.split('').map((ch, i) => {
        if (i < done || ch === ' ') return ch;
        return chars[Math.floor(Math.random() * chars.length)];
      }).join('');
      link.textContent = done >= original.length ? original : out;
      if (done < original.length) raf = requestAnimationFrame(run);
      else raf = null;
    };
    link.addEventListener('mouseenter', () => {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      frame = 0;
      if (raf) cancelAnimationFrame(raf);
      raf = requestAnimationFrame(run);
    });
  });
</script>