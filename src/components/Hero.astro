---
import type { Translations } from '../i18n';

interface Props {
  t: Translations;
}
const { t } = Astro.props;
---

<section id="hero-section" class="relative min-h-screen flex flex-col justify-center px-8 pt-16">
  <div class="max-w-5xl mx-auto w-full fade-in">

    <!-- Single eyebrow (only one on the page) -->
    <p
      class="mono-label mb-8"
      style="color: var(--color-accent);"
    >
      {t.hero.label}
    </p>

    <!-- Massive name, top-left aligned, full width -->
    <h1
      id="hero-name"
      class="hero-enter leading-none mb-12"
      style="
        font-family: var(--font-display);
        font-weight: 900;
        font-stretch: 125%;
        font-size: clamp(3rem, 12vw, 9rem);
        color: var(--color-fg);
        letter-spacing: -0.03em;
        text-transform: uppercase;
      "
    >
      Miguel<br />Padín Domínguez
    </h1>

    <!-- One thin hairline rule -->
    <div class="mb-12 w-full" style="height: 1px; background: var(--color-border);"></div>

    <!-- Asymmetric two-column row: bio in a narrow offset column, links right -->
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-[240px_1fr]">
      <p
        class="max-w-lg text-base leading-loose"
        style="color: var(--color-secondary);"
      >
        {t.hero.bio}
      </p>

      <div class="flex items-start gap-6 flex-wrap lg:justify-end">
        {[
          { label: 'LinkedIn',  href: 'https://linkedin.com/in/miguelpadin' },
          { label: 'GitHub',    href: 'https://github.com/miguelpadin' },
          { label: 'Email',     href: 'mailto:miguel.padin.dominguez@gmail.com' },
          { label: 'WhatsApp',  href: 'https://wa.me/34639476354' },
          { label: 'Telegram',  href: 'https://t.me/+34639476354' },
        ].map(({ label, href }) => (
          <a
            href={href}
            target={href.startsWith('http') ? '_blank' : undefined}
            rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}
            class="contact-link mono-label link-underline transition-colors duration-200"
            style="color: var(--color-muted); text-transform: none; letter-spacing: 0.04em;"
          >
            {label}
          </a>
        ))}
      </div>
    </div>
  </div>

</section>